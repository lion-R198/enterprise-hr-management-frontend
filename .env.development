# 开发环境配置
# 说明：前端已统一走真实后端 API，本地 mock 数据通道已从请求链路上移除
# （src/mock 仅作历史归档，不再被 src/utils/request.js 引用，无法被任何环境变量激活）
# 统一 API 前缀（与后端 /api 契约一致）
VITE_BASE_API = /api
# 真实后端地址（vite dev server 的 /api 代理目标）
VITE_PROXY_TARGET = http://localhost:8080
# 本地令牌持久化键名
VITE_TOKEN_KEY = EHR_TOKEN
# 联调取证开关：置为 true 时，每条经代理的 /api 请求逐条写入 verify/proxy-access.jsonl
# 用途：验证「前端请求确实打到了后端」——mock 通道不产生 HTTP 出行，不会出现在该日志中
VITE_LOG_PROXY = false
